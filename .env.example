# ==========================================================
# VYAPAR CRM & ERP - ENVIRONMENT CONFIGURATION
# ==========================================================

# Server Port (Render sets this automatically)
PORT=5000

# Node Environment
NODE_ENV=production

# First administrator, created only when no admin account exists
INITIAL_ADMIN_NAME=Vyapar Administrator
INITIAL_ADMIN_EMAIL=admin@vyapar.local
INITIAL_ADMIN_PASSWORD=Admin123
INITIAL_ADMIN_PIN=12345678

# ==========================================================
# DATABASE SETTINGS
# Note: Leave DB_HOST blank to use zero-config built-in SQLite
# ==========================================================
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASS=your_password
# DB_NAME=vyapar

# Optional alternate SQLite path (useful for tests and persistent disks)
# SQLITE_PATH=/var/data/vyapar.db
